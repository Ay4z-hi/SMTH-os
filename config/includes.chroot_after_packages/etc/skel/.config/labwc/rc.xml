<?xml version="1.0"?>
<labwc_config>
  <theme><name>SMTH</name><cornerRadius>14</cornerRadius><font name="Inter" size="10"/></theme>
  <keyboard>
    <default/>
    <keybind key="W-Return"><action name="Execute" command="alacritty"/></keybind>
    <keybind key="W-space"><action name="Execute" command="smth-launcher"/></keybind>
    <keybind key="W-d"><action name="Execute" command="fuzzel"/></keybind>
    <keybind key="W-grave"><action name="Execute" command="smth-term-overlay"/></keybind>
    <keybind key="W-e"><action name="Execute" command="smth-files"/></keybind>
    <keybind key="W-i"><action name="Execute" command="smth-settings"/></keybind>
    <keybind key="W-n"><action name="Execute" command="pkill -USR1 -f lib/smth/notifd.py"/></keybind>
    <keybind key="W-l"><action name="Execute" command="smth-lock"/></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left"/></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right"/></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize"/></keybind>
    <keybind key="W-q"><action name="Close"/></keybind>
  </keyboard>
  <windowRules>
    
    <windowRule identifier="smth-overlay"><action name="ToggleAlwaysOnTop"/></windowRule>
  </windowRules>
</labwc_config>
