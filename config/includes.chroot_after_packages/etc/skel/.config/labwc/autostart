# SMTH session start-up.
# smthd supervises the long-lived shell helpers (notifications, layout watcher)
# and restarts them with backoff if they die. If it cannot start, fall back to
# launching them directly so the desktop still comes up.
( smthd --config /etc/smth/services.json --palette /usr/local/lib/smth/palette.json || { smth-notifd & smth-moded & } ) >/dev/null 2>&1 &
# The real desktop starts first.  The reveal overlay runs above these
# surfaces and fades out to reveal them; it is disabled by Settings or by
# SMTH_NO_STARTUP_ANIMATION=1, and reduces to a short reveal under Reduce Motion.
# smth-session-startup picks the AHIAN reconstruction when AHIAN mode is on and
# the regular SMTH startup otherwise, so exactly one reveal runs per session.
smth-mode auto >/dev/null 2>&1 &
# The reveal starts first so the desktop can never flash before it; the live
# desktop paints underneath and is ready when the overlay fades.
timeout 15 smth-session-startup >/dev/null 2>&1 &
( smth-home || swaybg -m fill -i /usr/share/backgrounds/smth/wallpaper.png ) >/dev/null 2>&1 &
swayidle -w timeout 300 'smth-lock' before-sleep 'smth-lock' >/dev/null 2>&1 &
