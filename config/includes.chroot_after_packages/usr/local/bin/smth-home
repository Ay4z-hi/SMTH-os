#!/usr/bin/env bash
# Resolve libgtk4-layer-shell.so and preload it so Gtk4LayerShell can create
# real layer surfaces. Fall back to a direct search of the standard library
# directories when ldconfig has no cache entry (minimal images, containers).
lib=""
if command -v ldconfig >/dev/null 2>&1; then
  lib="$(ldconfig -p 2>/dev/null | awk '/libgtk4-layer-shell\\.so /{print $NF; exit}')"
fi
if [ -z "$lib" ]; then
  for candidate in \
      /usr/lib/x86_64-linux-gnu/libgtk4-layer-shell.so \
      /usr/lib/aarch64-linux-gnu/libgtk4-layer-shell.so \
      /usr/lib64/libgtk4-layer-shell.so \
      /usr/lib/libgtk4-layer-shell.so; do
    if [ -f "$candidate" ]; then lib="$candidate"; break; fi
  done
fi
if [ -z "$lib" ]; then
  lib="$(find /usr/lib /usr/lib64 -name 'libgtk4-layer-shell.so*' -type f 2>/dev/null | head -n 1)"
fi
[ -n "$lib" ] && export LD_PRELOAD="$lib"
exec python3 /usr/local/lib/smth/home.py "$@"