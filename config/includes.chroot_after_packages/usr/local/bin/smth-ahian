#!/usr/bin/env python3
"""smth-ahian: trigger the Ahian easter egg.

This is a simple wrapper that calls the ahian script.
"""

import subprocess
import sys

def main():
    try:
        result = subprocess.run(
            ["/usr/local/bin/ahian"] + sys.argv[1:],
            capture_output=True,
            text=True
        )
        if result.stdout:
            print(result.stdout)
        if result.stderr:
            print(result.stderr, file=sys.stderr)
        return result.returncode
    except FileNotFoundError:
        print("Error: ahian script not found at /usr/local/bin/ahian", file=sys.stderr)
        return 1

if __name__ == "__main__":
    sys.exit(main())
