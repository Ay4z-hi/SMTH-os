#!/usr/bin/env python3
"""ahian: activate AHIAN mode — an alternative cold-glass desktop.

`ahian` (or `ahian on`) switches the desktop into AHIAN mode directly:
cold-glass wallpaper, spatial UI, all apps and desktop functionality intact.

`unahian` (or `ahian off`) exits AHIAN mode immediately and restores the
previous (normal) desktop state. It plays no animation at all.

Activating AHIAN plays the takeover exactly once: ten seconds of custom error
windows over the desktop you are already using, then a full-screen AH1AN system
screen with a nine second countdown. At zero the countdown stops and the screen
is removed to reveal the live AHIAN desktop that was switched in underneath it
while the blue screen was covering the display. Nothing is rendered, captured
or swapped in: the same running session simply becomes visible. The frames are
the shared ``ahian_scene`` renderer, the same one the Windows launcher and the
Android launcher draw. Tap, click or any key skips it.
"""
import json, os, shutil, subprocess, sys

CFG = os.path.expanduser("~/.config/smth")
FLAG = os.path.join(CFG, "ahian")
WALLPAPER_PREF = os.path.join(CFG, "wallpaper")
SETTINGS = os.path.join(CFG, "settings.json")
AHIAN_WALL = "/usr/share/backgrounds/smth/ahian-teal.png"
NORMAL_WALL = "/usr/share/backgrounds/smth/wallpaper.png"


def write_state(ahian):
    os.makedirs(CFG, exist_ok=True)
    if ahian:
        open(FLAG, "w").close()
        open(WALLPAPER_PREF, "w").write(AHIAN_WALL + "\n")
        src = os.path.join(CFG, "waybar-ahian.css")
    else:
        for path in (FLAG, WALLPAPER_PREF):
            try:
                os.remove(path)
            except OSError:
                pass
        src = os.path.join(CFG, "waybar-normal.css")
    try:
        with open(SETTINGS) as fh:
            settings = json.load(fh)
    except (OSError, ValueError):
        settings = {}
    settings.update({"schema": 1, "ahian": bool(ahian)})
    try:
        tmp = SETTINGS + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(settings, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, SETTINGS)
    except OSError:
        pass
    if os.path.exists(src):
        shutil.copyfile(src, os.path.join(CFG, "waybar.css"))
    for signal, target in (("-USR1", "lib/smth/home.py"), ("-USR2", "waybar")):
        try:
            subprocess.run(["pkill", signal, "-f", target], check=False)
        except (OSError, subprocess.SubprocessError):
            pass


def animation_disabled():
    """True when the takeover must not play, so the theme applies at once."""
    if os.environ.get("SMTH_NO_STARTUP_ANIMATION", "").strip().lower() in (
            "1", "on", "true", "yes"):
        return True
    try:
        with open(os.path.join(CFG, "startup-animation"), encoding="utf-8") as fh:
            if fh.read().strip().lower() in ("0", "off", "false", "no"):
                return True
    except OSError:
        pass
    try:
        with open("/proc/cmdline", encoding="utf-8", errors="replace") as fh:
            if "smth.no_startup_animation=1" in fh.read():
                return True
    except OSError:
        pass
    return False


def notify(title, body=""):
    try:
        subprocess.run(["notify-send", "-a", "SMTH", title, body], check=False,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        pass


def ahian(on):
    if on:
        already = os.path.exists(FLAG)
        static = animation_disabled()
        # Start the overlay first.  Act 1 runs over the desktop that is on
        # screen right now; the AHIAN wallpaper and taskbar are switched in
        # behind the blue screen, then revealed at the countdown's zero.
        try:
            subprocess.Popen(
                ["sh", "-c", "exec /usr/local/bin/smth-ahian-startup"],
                stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, start_new_session=True,
                env={**os.environ, "SMTH_AHIAN_ACTIVATE": "1"},
            )
        except (OSError, subprocess.SubprocessError):
            pass
        if already:
            write_state(True)
            notify("AHIAN", "AHIAN mode activated.")
        elif static:
            # No takeover will play, so there is no blue screen to hide behind.
            write_state(True)
            notify("AHIAN", "AHIAN mode activated.")
        else:
            try:
                # The overlay switches at the blue screen; this only covers
                # a session where the overlay could not start at all.
                subprocess.Popen(
                    ["sh", "-c", "sleep 16; exec /usr/local/bin/ahian --activate"],
                    stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                    stderr=subprocess.DEVNULL, start_new_session=True,
                )
            except (OSError, subprocess.SubprocessError):
                write_state(True)
        print("\n  AHIAN MODE ON  cold glass · spatial UI · all apps available\n"
              "  run `unahian` to return to normal mode\n")
    else:
        write_state(False)
        print("  ahian mode off — normal experience restored\n")
        notify("AHIAN", "Normal mode restored.")


def main():
    arg = (sys.argv[1].lower() if len(sys.argv) > 1 else "")
    if arg in ("off", "0", "stop", "unahian"):
        ahian(False)
    elif arg == "--activate":
        # Deferred half of `ahian`: switch the live desktop while the AH1AN
        # screen is covering it, so the zero reveal is the real thing. No
        # notification: it would flash over the countdown.
        write_state(True)
    elif arg in ("on", "1", "start", ""):
        ahian(True)
    else:
        print("usage: ahian [on|off|unahian]\n"
              "  ahian          activate AHIAN mode\n"
              "  unahian        restore normal mode")
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
