#!/usr/bin/env python3
"""ahian: the SMTH OS easter egg.

Sequence (timings come from the tested Rust planner `smth-ahian`):

  1. the terminal prints a progressive error sequence,
  2. error dialogs appear gradually and fill the screen over ~10 s,
  3. a Windows-style blue screen appears reading
     "wants to make your life beautiful",
  4. a 9 second countdown runs,
  5. the desktop transitions into the AHIAN experience (purple/teal).

`unahian` (or `ahian off`) shows the angry red screen reading
"looks like you dont like ahian" and restores the normal experience.

Without a display the script still switches modes and prints the sequence, so
it is usable over SSH. GTK/layer-shell is optional.
"""
import json, os, shutil, subprocess, sys, time

CFG = os.path.expanduser("~/.config/smth")
FLAG = os.path.join(CFG, "ahian")
WALLPAPER_PREF = os.path.join(CFG, "wallpaper")
SETTINGS = os.path.join(CFG, "settings.json")
AHIAN_WALL = "/usr/share/backgrounds/smth/ahian-teal.png"
NORMAL_WALL = "/usr/share/backgrounds/smth/wallpaper.png"
PLANNER = "/usr/bin/smth-ahian"
FALLBACK_PLAN = {
    "seed": 2026, "fill_ms": 10000,
    "bsod": {"at_ms": 10000, "message": "wants to make your life beautiful",
             "stop_code": "AHIAN_BEAUTY_ATTEMPTED", "countdown_seconds": 9,
             "heading": "SMTH OS", "accent": "#d71921"},
    "wallpaper": AHIAN_WALL,
    "errors": [{"at_ms": i * 150, "text": t} for i, t in enumerate([
        "smth-core: cannot resolve symbol `home`", "segmentation fault (core dumped)",
        "wayland: compositor rejected surface", "ahian.so: undefined reference to `beauty`",
        "error: 0x0000A1A1 memory not found", "AHIAN: something wants to be beautiful"])],
    "dialogs": [],
}
FALLBACK_UNAHIAN = {"message": "looks like you dont like ahian", "accent": "#d71921",
                    "heading": "AHIAN HAS BEEN DISABLED", "hold_ms": 2600,
                    "restore_wallpaper": NORMAL_WALL}
BLUE = "#12245b"          # the joke blue screen, deliberately not a palette colour


def planner(*args):
    try:
        out = subprocess.run([PLANNER, *args], capture_output=True, text=True, timeout=15)
        if out.returncode == 0 and out.stdout.strip():
            return json.loads(out.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return None


def screen_size():
    try:
        out = subprocess.run(["wlr-randr"], capture_output=True, text=True, timeout=4).stdout
        best = (1920, 1080)
        for line in out.splitlines():
            if line and not line[0].isspace():
                for token in line.split():
                    if "x" in token and token.replace("x", "").isdigit():
                        w, h = (int(v) for v in token.split("x"))
                        if w >= best[0]:
                            best = (w, h)
                        break
        return best
    except (OSError, subprocess.SubprocessError):
        return (1920, 1080)


def write_state(ahian):
    os.makedirs(CFG, exist_ok=True)
    if ahian:
        open(FLAG, "w").close()
        open(WALLPAPER_PREF, "w").write(AHIAN_WALL + "\n")
        src = os.path.join(CFG, "waybar-ahian.css")
    else:
        for path in (FLAG, WALLPAPER_PREF):
            try:
                os.remove(path)
            except OSError:
                pass
        src = os.path.join(CFG, "waybar-normal.css")
    try:
        with open(SETTINGS) as fh:
            settings = json.load(fh)
    except (OSError, ValueError):
        settings = {}
    settings.update({"schema": 1, "ahian": bool(ahian)})
    try:
        tmp = SETTINGS + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(settings, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, SETTINGS)
    except OSError:
        pass
    if os.path.exists(src):
        shutil.copyfile(src, os.path.join(CFG, "waybar.css"))
    subprocess.run(["pkill", "-USR1", "-f", "lib/smth/home.py"], check=False)
    subprocess.run(["pkill", "-USR2", "waybar"], check=False)


def notify(title, body=""):
    subprocess.run(["notify-send", "-a", "SMTH", title, body], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def term_lines(lines, progress=None):
    """Print the terminal error sequence with the plan's own pacing."""
    for i, item in enumerate(lines):
        print(f"\033[38;2;215;25;33m{item['text']}\033[0m", flush=True)
        if progress:
            progress()
        if i + 1 < len(lines):
            nxt = lines[i + 1]["at_ms"]
            time.sleep(max(0.0, min(0.4, (nxt - item["at_ms"]) / 1000)))


# ---------------------------------------------------------------- GTK sequence
def run_ui(plan, on_done):
    import gi
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gdk, GLib, Gtk
    try:
        gi.require_version("Gtk4LayerShell", "1.0")
        from gi.repository import Gtk4LayerShell as LS
    except (ImportError, ValueError):
        LS = None

    accent = plan["bsod"].get("accent", "#d71921")
    dialogs = plan.get("dialogs") or []
    bsod = plan["bsod"]
    countdown = int(bsod.get("countdown_seconds", 9))

    app = Gtk.Application(application_id="os.smth.AhianSequence")

    def place(win, x, y, w, h):
        if LS:
            LS.init_for_window(win)
            LS.set_namespace(win, "smth-ahian")
            LS.set_layer(win, LS.Layer.OVERLAY)
            LS.set_anchor(win, LS.Edge.TOP, True)
            LS.set_anchor(win, LS.Edge.LEFT, True)
            LS.set_margin(win, LS.Edge.TOP, max(0, y))
            LS.set_margin(win, LS.Edge.LEFT, max(0, x))
            LS.set_keyboard_mode(win, LS.KeyboardMode.NONE)
            win.set_default_size(w, h)
        else:
            win.set_default_size(w, h)

    def dialog(spec):
        win = Gtk.Window(application=app)
        win.set_decorated(False)
        win.set_resizable(False)
        rect = spec["rect"]
        place(win, rect["x"], rect["y"], rect["w"], rect["h"])
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                      margin_top=12, margin_bottom=12, margin_start=14, margin_end=14)
        head = Gtk.Box(spacing=10)
        dot = Gtk.Label(label="●")
        dot.set_markup(f'<span color="{accent}" size="x-large">●</span>')
        head.append(dot)
        title = Gtk.Label(label=spec["title"], xalign=0, wrap=True)
        title.set_markup(f'<b>{GLib.markup_escape_text(spec["title"])}</b>')
        head.append(title)
        box.append(head)
        body = Gtk.Label(label=spec["body"], xalign=0, wrap=True)
        body.add_css_class("dim-label")
        box.append(body)
        foot = Gtk.Button(label="OK", halign=Gtk.Align.END)
        foot.add_css_class("pill")
        foot.connect("clicked", lambda *_: win.close())
        box.append(foot)
        win.set_child(box)
        css = Gtk.CssProvider()
        css.load_from_data(
            f"window {{ background: #000000; border: 1px solid {accent}; border-radius: 6px; }}"
            "label { color: #ffffff; font-family: 'Space Mono', monospace; font-size: 12px; }"
            "button { color: #ffffff; background: #000000; border: 1px solid #8c8c8c; border-radius: 4px; }"
            .encode())
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        win.present()
        return win

    state = {"windows": [], "bsod": None, "label": None, "left": countdown}

    def show_bsod():
        for win in state["windows"]:
            win.close()
        state["windows"].clear()
        win = Gtk.Window(application=app)
        win.set_decorated(False)
        if LS:
            LS.init_for_window(win)
            LS.set_namespace(win, "smth-ahian-bsod")
            LS.set_layer(win, LS.Layer.OVERLAY)
            for edge in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
                LS.set_anchor(win, edge, True)
            LS.set_exclusive_zone(win, -1)
            LS.set_keyboard_mode(win, LS.KeyboardMode.NONE)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18,
                      margin_top=80, margin_bottom=80, margin_start=90, margin_end=90,
                      valign=Gtk.Align.CENTER)
        mark = Gtk.Label()
        mark.set_markup(f'<span color="{accent}" size="xx-large">●</span>')
        mark.set_halign(Gtk.Align.START)
        box.append(mark)
        head = Gtk.Label(xalign=0, wrap=True)
        head.set_markup("<b>SMTH OS</b>")
        box.append(head)
        msg = Gtk.Label(xalign=0, wrap=True, label=bsod["message"])
        box.append(msg)
        sub = Gtk.Label(xalign=0, wrap=True)
        sub.set_markup(
            f'<span size="small">Stop code: {GLib.markup_escape_text(bsod.get("stop_code", "AHIAN"))}</span>')
        sub.add_css_class("dim-label")
        box.append(sub)
        state["label"] = Gtk.Label(xalign=0)
        box.append(state["label"])
        win.set_child(box)
        css = Gtk.CssProvider()
        css.load_from_data(
            f"window {{ background: {BLUE}; }}"
            "label { color: #ffffff; font-family: 'Space Mono', monospace; font-size: 22px; }"
            "label.dim-label { color: #cfd8ff; font-size: 14px; }".encode())
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        state["label"].set_text(f"making your life beautiful in {countdown}…")
        win.present()
        state["bsod"] = win
        # Show 9 immediately, then 8…1 and close at zero: a full 9 seconds.
        GLib.timeout_add(1000, tick)

    def tick():
        state["left"] -= 1
        if state["label"] is not None:
            state["label"].set_text(f"making your life beautiful in {max(0, state['left'])}…")
        if state["left"] <= 0:
            state["bsod"].close()
            app.quit()
            on_done()
            return False
        GLib.timeout_add(1000, tick)
        return False

    def activate(application):
        for spec in dialogs:
            GLib.timeout_add(spec["at_ms"], lambda s=spec: (state["windows"].append(dialog(s)), False)[1])
        GLib.timeout_add(int(plan.get("fill_ms", 10000)), lambda: (show_bsod(), False)[1])

    app.connect("activate", activate)
    if app.run([]) != 0:
        raise SystemExit(1)


def ahian(on, arg=""):
    if on:
        width, height = screen_size()
        plan = planner("plan", "2026", f"{width}x{height}") or FALLBACK_PLAN
        print("\n\033[1mSMTH OS\033[0m — something wants to be beautiful\n")
        started = time.time()
        try:
            run_ui(plan, lambda: None)
        except (ImportError, ValueError, SystemExit, OSError):
            # Headless or no GTK: run the same timeline in the terminal only.
            term_lines(plan["errors"])
            time.sleep(max(0.0, plan.get("fill_ms", 10000) / 1000 - (time.time() - started)))
            print(f"\n  SMTH OS\n  {plan['bsod']['message']}")
            for n in range(int(plan["bsod"].get("countdown_seconds", 9)), 0, -1):
                print(f"  making your life beautiful in {n}…", flush=True)
                time.sleep(1)
        write_state(True)
        print("\n  \033[1mAHIAN MODE ON\033[0m  purple/teal dot field · dot clock · orbiting dots\n"
              "  run \033[1munahian\033[0m to return\n")
        notify("AHIAN", "Something wants to make your life beautiful.")
    else:
        plan = planner("unplan") or FALLBACK_UNAHIAN
        width, height = screen_size()
        print(f"\n\033[38;2;215;25;33m  {plan['heading']}\033[0m\n  {plan['message']}\n")
        try:
            import gi
            gi.require_version("Gtk", "4.0")
            from gi.repository import GLib, Gtk
            try:
                gi.require_version("Gtk4LayerShell", "1.0")
                from gi.repository import Gtk4LayerShell as LS
            except (ImportError, ValueError):
                LS = None
            app = Gtk.Application(application_id="os.smth.UnAhian")
            css = Gtk.CssProvider()
            css.load_from_data(
                f"window {{ background: #000000; border: 6px solid {plan.get('accent', '#d71921')}; }}"
                "label { color: #ffffff; font-family: 'Doto', 'Space Mono', monospace; }".encode())

            def activate(a):
                win = Gtk.Window(application=a)
                win.set_decorated(False)
                win.set_default_size(width, height)
                if LS:
                    LS.init_for_window(win)
                    LS.set_namespace(win, "smth-unahian")
                    LS.set_layer(win, LS.Layer.OVERLAY)
                    for edge in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
                        LS.set_anchor(win, edge, True)
                    LS.set_exclusive_zone(win, -1)
                    LS.set_keyboard_mode(win, LS.KeyboardMode.NONE)
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16,
                              valign=Gtk.Align.CENTER, halign=Gtk.Align.CENTER)
                title = Gtk.Label()
                title.set_markup(f'<span size="xx-large">{plan["message"]}</span>')
                box.append(title)
                from gi.repository import Gdk
                Gtk.StyleContext.add_provider_for_display(
                    Gdk.Display.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
                win.set_child(box)
                win.present()
                GLib.timeout_add(int(plan.get("hold_ms", 2600)), lambda: (a.quit(), False)[1])

            app.connect("activate", activate)
            app.run([])
        except (ImportError, ValueError, OSError):
            time.sleep(plan.get("hold_ms", 2600) / 1000)
        write_state(False)
        print("  ahian mode off — normal experience restored\n")
        notify("AHIAN", plan["message"])


def main():
    arg = sys.argv[1].lower() if len(sys.argv) > 1 else ""
    if arg in ("off", "0", "stop", "unahian"):
        ahian(False)
    elif arg in ("on", "1", "start", ""):
        ahian(True)
    else:
        print("usage: ahian [on|off|unahian]\n"
              "  ahian          start the AHIAN experience\n"
              "  unahian        angry red screen, then restore normal mode")
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
