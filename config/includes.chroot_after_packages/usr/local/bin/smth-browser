#!/usr/bin/env python3
"""SMTH Browser: lightweight WebKitGTK browser with tabs, ad blocking, downloads, start page."""
import json, os, sys
os.environ.setdefault("WEBKIT_DISABLE_DMABUF_RENDERER", "1")
sys.path.insert(0, "/usr/local/lib/smth")
import gi
gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1"); gi.require_version("WebKit", "6.0")
from gi.repository import Adw, Gdk, GLib, Gtk, WebKit
import smthdot as D

DL = os.path.expanduser("~/Downloads"); os.makedirs(DL, exist_ok=True)
DATA = os.path.expanduser("~/.local/share/smth-browser"); os.makedirs(DATA, exist_ok=True)
BLOCK = ["doubleclick.net", "googlesyndication.com", "googleadservices.com", "google-analytics.com", "googletagmanager.com", "adservice.google.com",
         "facebook.net", "connect.facebook.net", "taboola.com", "outbrain.com", "criteo.com", "adnxs.com", "scorecardresearch.com", "hotjar.com",
         "quantserve.com", "amazon-adsystem.com", "adsrvr.org", "rubiconproject.com", "pubmatic.com", "moatads.com", "zedo.com", "mixpanel.com"]
START = """<html><body style="margin:0;background:#000;color:#fff;font-family:sans-serif;display:flex;flex-direction:column;align-items:center;justify-content:center;height:100vh">
<div style="font-size:64px;font-weight:700;letter-spacing:.3em;background:linear-gradient(90deg,#7C5CFF,#19E6D0);-webkit-background-clip:text;color:transparent">SMTH</div>
<form action="https://duckduckgo.com/" style="margin-top:36px"><input name="q" autofocus placeholder="Search or type an address" style="width:min(560px,80vw);padding:16px 22px;border-radius:999px;border:1px solid #2b2b44;background:#0b0b16;color:#fff;font-size:17px;outline:none"></form></body></html>"""

def to_url(t):
    t = t.strip()
    if "://" in t or t.startswith("about:"): return t
    if "." in t and " " not in t: return "https://" + t
    return "https://duckduckgo.com/?q=" + GLib.uri_escape_string(t, None, True)

class Browser(Adw.ApplicationWindow):
    def __init__(self, app, first):
        super().__init__(application=app, default_width=1100, default_height=720)
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        self.filter = None; self.tabs = Adw.TabView()
        self.entry = Gtk.Entry(hexpand=True, placeholder_text="Search or type an address", width_chars=48)
        self.entry.connect("activate", lambda e: self.cur().load_uri(to_url(e.get_text())))
        def nb(icon, fn): b = Gtk.Button(icon_name=icon); b.connect("clicked", lambda *_: fn()); return b
        hb = Adw.HeaderBar(title_widget=self.entry); hb.add_css_class("flat")
        for b in (nb("go-previous-symbolic", lambda: self.cur().go_back()), nb("go-next-symbolic", lambda: self.cur().go_forward()), nb("view-refresh-symbolic", lambda: self.cur().reload())): hb.pack_start(b)
        hb.pack_end(nb("tab-new-symbolic", lambda: self.new_tab(None)))
        tv = Adw.ToolbarView(content=self.tabs); tv.add_top_bar(hb); tv.add_top_bar(Adw.TabBar(view=self.tabs, autohide=False)); self.set_content(tv)
        self.tabs.connect("notify::selected-page", lambda *_: self.sync())
        s = WebKit.NetworkSession.get_default(); s.connect("download-started", self.on_download)
        try:
            store = WebKit.UserContentFilterStore.new(os.path.join(DATA, "filters"))
            rules = json.dumps([{"trigger": {"url-filter": r"^https?://([^/]*\.)?" + d.replace(".", r"\.") + r"[:/]"}, "action": {"type": "block"}} for d in BLOCK])
            store.save("ads", GLib.Bytes.new(rules.encode()), None, self.filter_ready)
        except Exception as e: print("adblock off:", e)
        self.new_tab(first)
        key = Gtk.EventControllerKey(); key.connect("key-pressed", self.on_key); self.add_controller(key)

    def filter_ready(self, store, res):
        try: self.filter = store.save_finish(res)
        except Exception as e: print("filter:", e); return
        for i in range(self.tabs.get_n_pages()): self.tabs.get_nth_page(i).get_child().get_user_content_manager().add_filter(self.filter)

    def cur(self): return self.tabs.get_selected_page().get_child()

    def new_tab(self, url, related=None):
        web = WebKit.WebView(related_view=related) if related else WebKit.WebView()
        if self.filter: web.get_user_content_manager().add_filter(self.filter)
        page = self.tabs.append(web); page.set_title("New tab"); self.tabs.set_selected_page(page)
        web.connect("notify::title", lambda w, _: page.set_title(w.get_title() or "New tab"))
        web.connect("notify::uri", lambda w, _: self.sync() if w is self.cur() else None)
        web.connect("notify::estimated-load-progress", lambda w, _: self.entry.set_progress_fraction(w.get_estimated_load_progress() if w.is_loading() else 0.0) if w is self.cur() else None)
        web.connect("create", lambda w, nav: self.new_tab(None, related=w))
        if url: web.load_uri(to_url(url))
        elif not related: web.load_html(START, "smth://start")
        return web

    def sync(self):
        if not self.tabs.get_selected_page(): return
        u = self.cur().get_uri() or ""; self.entry.set_text("" if u.startswith("smth://") else u)

    def on_download(self, session, dl):
        def dest(d, name): d.set_destination(os.path.join(DL, name)); return True
        dl.connect("decide-destination", dest)

    def on_key(self, c, val, code, state):
        if state & Gdk.ModifierType.CONTROL_MASK:
            if val == Gdk.KEY_t: self.new_tab(None); return True
            if val == Gdk.KEY_w and self.tabs.get_n_pages() > 1: self.tabs.close_page(self.tabs.get_selected_page()); return True
            if val == Gdk.KEY_l: self.entry.grab_focus(); return True
            if val == Gdk.KEY_r: self.cur().reload(); return True
        return False

first = sys.argv[1] if len(sys.argv) > 1 else None
app = Adw.Application(application_id="os.smth.Browser"); app.connect("activate", lambda a: Browser(a, first).present())
sys.exit(app.run(sys.argv[:1]))
