#!/usr/bin/env python3
"""SMTH Gallery: thumbnail grid, pinch/scroll zoom, EXIF inspector, basic editor."""
import io, os, subprocess, sys, threading
sys.path.insert(0, "/usr/local/lib/smth")
import gi
gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1"); gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Adw, Gdk, GdkPixbuf, Gio, GLib, Gtk
from PIL import Image, ImageEnhance, ImageOps, ExifTags
import smthdot as D

EXTS = (".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp")
ROOT = sys.argv[1] if len(sys.argv) > 1 and os.path.isdir(sys.argv[1]) else os.path.expanduser("~/Pictures")

def texture_from_pil(im):
    im = im.convert("RGB"); w, h = im.size
    return Gdk.MemoryTexture.new(w, h, Gdk.MemoryFormat.R8G8B8, GLib.Bytes.new(im.tobytes()), w * 3)

def scan(root):
    out = []
    for d, _, fs in os.walk(root):
        for f in fs:
            if f.lower().endswith(EXTS): out.append(os.path.join(d, f))
    return sorted(out, key=os.path.getmtime, reverse=True)

class Gallery(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, default_width=460, default_height=800)
        self.nav = Adw.NavigationView(); self.set_content(self.nav)
        self.nav.push(self.grid_page())

    # ---------- grid ----------
    def grid_page(self):
        self.flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, min_children_per_line=3, max_children_per_line=8,
                                row_spacing=4, column_spacing=4, margin_start=6, margin_end=6, margin_top=6)
        self.flow.connect("child-activated", lambda f, c: self.open_viewer(c.path))
        self.empty = Gtk.Label(label="NO PHOTOS YET", css_classes=["dim-label"], vexpand=True)
        self.stack = Gtk.Stack(); self.stack.add_named(Gtk.ScrolledWindow(child=self.flow), "grid"); self.stack.add_named(self.empty, "empty")
        tv = Adw.ToolbarView(content=self.stack)
        hb = Adw.HeaderBar(title_widget=D.dot_label("GALLERY", 3)); hb.add_css_class("flat")
        ref = Gtk.Button(icon_name="view-refresh-symbolic"); ref.connect("clicked", lambda *_: self.reload()); hb.pack_end(ref)
        tv.add_top_bar(hb)
        self.reload()
        return Adw.NavigationPage(child=tv, title="Gallery")

    def reload(self):
        while (c := self.flow.get_first_child()): self.flow.remove(c)
        files = scan(ROOT)
        self.stack.set_visible_child_name("grid" if files else "empty")
        for p in files[:600]:
            pic = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, can_shrink=True); pic.set_size_request(110, 110)
            child = Gtk.FlowBoxChild(child=pic); child.path = p; self.flow.append(child)
            threading.Thread(target=self.load_thumb, args=(p, pic), daemon=True).start()

    def load_thumb(self, p, pic):
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(p, 260, 260, True)
            GLib.idle_add(lambda: (pic.set_paintable(Gdk.Texture.new_for_pixbuf(pb)), False)[1])
        except Exception:
            pass

    # ---------- viewer ----------
    def open_viewer(self, path):
        self.path = path; self.orig = Image.open(path); self.orig.load(); self.orig = ImageOps.exif_transpose(self.orig)
        self.work = self.orig.copy(); self.zoom = 1.0; self.base = 1.0; self.editing = False
        self.pic = Gtk.Picture(can_shrink=False, content_fit=Gtk.ContentFit.FILL)
        self.scroll = Gtk.ScrolledWindow(child=self.pic)
        z = Gtk.GestureZoom(); z.connect("begin", lambda *_: setattr(self, "base", self.zoom))
        z.connect("scale-changed", lambda g, s: self.set_zoom(self.base * s)); self.scroll.add_controller(z)
        sc = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)
        def on_scroll(c, dx, dy):
            if c.get_current_event_state() & Gdk.ModifierType.CONTROL_MASK:
                self.set_zoom(self.zoom * (0.9 if dy > 0 else 1.1)); return True
            return False
        sc.connect("scroll", on_scroll); self.scroll.add_controller(sc)

        tv = Adw.ToolbarView(content=self.scroll)
        hb = Adw.HeaderBar(); hb.add_css_class("flat"); hb.set_title_widget(Gtk.Label(label=os.path.basename(path), ellipsize=3))
        info = Gtk.Button(icon_name="dialog-information-symbolic"); info.connect("clicked", self.show_info)
        edit = Gtk.ToggleButton(icon_name="document-edit-symbolic"); edit.connect("toggled", self.toggle_edit)
        dele = Gtk.Button(icon_name="user-trash-symbolic"); dele.connect("clicked", self.trash)
        for b in (dele, edit, info): hb.pack_end(b)
        tv.add_top_bar(hb)
        self.edit_bar = self.build_editor(); self.edit_bar.set_visible(False); tv.add_bottom_bar(self.edit_bar)
        self.nav.push(Adw.NavigationPage(child=tv, title="Photo"))
        self.fit(); self.render()

    def fit(self):
        w, h = self.orig.size; self.zoom = min(440 / w, 640 / h, 1.0)

    def set_zoom(self, z):
        self.zoom = max(0.05, min(z, 8.0)); self.apply_size()

    def apply_size(self):
        w, h = self.work.size; self.pic.set_size_request(int(w * self.zoom), int(h * self.zoom))

    def render(self):
        self.pic.set_paintable(texture_from_pil(self.work)); self.apply_size()

    def trash(self, *_):
        try: Gio.File.new_for_path(self.path).trash(None)
        except GLib.Error: return
        self.nav.pop(); self.reload()

    def show_info(self, *_):
        lines = [f"{self.orig.width} x {self.orig.height}  {self.orig.format or ''}", f"{os.path.getsize(self.path) / 1024:.0f} KB"]
        try:
            for k, v in list(Image.open(self.path).getexif().items())[:24]:
                lines.append(f"{ExifTags.TAGS.get(k, k)}: {str(v)[:40]}")
        except Exception:
            pass
        d = Adw.AlertDialog(heading="Photo info", body="\n".join(lines)); d.add_response("ok", "Close"); d.present(self)

    # ---------- editor ----------
    def build_editor(self):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=8, margin_bottom=10, margin_start=10, margin_end=10)
        row = Gtk.Box(spacing=6, halign=Gtk.Align.CENTER)
        def btn(label, fn):
            b = Gtk.Button(label=label, css_classes=["pill"]); b.connect("clicked", lambda *_: fn()); row.append(b)
        btn("ROT L", lambda: self.op(lambda im: im.rotate(90, expand=True)))
        btn("ROT R", lambda: self.op(lambda im: im.rotate(-90, expand=True)))
        btn("FLIP", lambda: self.op(ImageOps.mirror))
        btn("B&W", lambda: self.op(lambda im: ImageOps.grayscale(im).convert("RGB")))
        btn("RESET", self.reset)
        box.append(row)
        self.bri = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.3, 1.7, 0.05); self.bri.set_value(1.0)
        self.con = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.3, 1.7, 0.05); self.con.set_value(1.0)
        self.bri.set_tooltip_text("Brightness"); self.con.set_tooltip_text("Contrast")
        self.bri.connect("value-changed", lambda *_: self.adjust()); self.con.connect("value-changed", lambda *_: self.adjust())
        box.append(self.bri); box.append(self.con)
        save = Gtk.Button(label="SAVE COPY", css_classes=["suggested-action", "pill"], halign=Gtk.Align.CENTER)
        save.connect("clicked", self.save_copy); box.append(save)
        return box

    def toggle_edit(self, b):
        self.edit_bar.set_visible(b.get_active())

    def op(self, fn):
        self.orig = fn(self.orig); self.adjust()

    def adjust(self):
        im = ImageEnhance.Brightness(self.orig.convert("RGB")).enhance(self.bri.get_value())
        self.work = ImageEnhance.Contrast(im).enhance(self.con.get_value()); self.render()

    def reset(self):
        self.orig = ImageOps.exif_transpose(Image.open(self.path)); self.bri.set_value(1.0); self.con.set_value(1.0); self.adjust()

    def save_copy(self, *_):
        base, _ = os.path.splitext(self.path); n = 1
        while os.path.exists(f"{base}_edit{n}.jpg"): n += 1
        self.work.convert("RGB").save(f"{base}_edit{n}.jpg", quality=93); self.reload()

app = Adw.Application(application_id="os.smth.Gallery")
app.connect("activate", lambda a: Gallery(a).present())
sys.exit(app.run(sys.argv[:1]))
