#!/usr/bin/env bash
# SMTH CoreLink v0: device discovery/pairing, file + clipboard sync (KDE Connect protocol), screen mirroring (wayvnc).
set -euo pipefail
# KDE Connect and WayVNC live in the signed Hypervisor extension to keep the
# core ISO inside its size budget; say so instead of failing with a bare 127.
for dep in kdeconnect-cli wayvnc; do
  command -v "$dep" >/dev/null || {
    echo "SMTH CoreLink needs the signed Hypervisor extension (missing: $dep)." >&2
    echo "Install it with: sudo smthctl extension install Hypervisor-$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/').smx" >&2
    exit 1
  }
done
case "${1:-status}" in
  status) kdeconnect-cli -l ;;
  pair)   kdeconnect-cli -d "${2:?device id}" --pair ;;
  send)   kdeconnect-cli -d "${2:?device id}" --share "${3:?file}" ;;
  clip)   wl-paste | kdeconnect-cli -d "${2:?device id}" --ping-msg "$(cat)" ;;
  mirror) echo "Mirroring on $(hostname -I | awk '{print $1}'):5900 (any VNC client)"; exec wayvnc 0.0.0.0 5900 ;;
  *) echo "usage: smth-corelink status|pair ID|send ID FILE|clip ID|mirror"; exit 2 ;;
esac
