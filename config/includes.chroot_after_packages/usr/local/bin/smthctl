#!/usr/bin/env python3
"""SMTH system control and signed .smx extension manager.

.smx is a ZIP container with manifest.json, manifest.sig and payload.squashfs.
The manifest is RSA/SHA-256 signed by /etc/smth/extensions.pub. The payload
is independently SHA-256 checked before it can be mounted read-only.
"""
import argparse
import hashlib
import json
import os
import pathlib
import shutil
import subprocess
import sys
import tempfile
import zipfile

PUBKEY = pathlib.Path("/etc/smth/extensions.pub")
STATE = pathlib.Path("/var/lib/smth/extensions")
MOUNT = pathlib.Path("/opt/smth/extensions")
APP_LINKS = pathlib.Path("/usr/local/share/applications")
MAX_MANIFEST = 256 * 1024
MAX_PAYLOAD = 2 * 1024 * 1024 * 1024


def run(args, check=True):
    return subprocess.run(args, check=check, text=True, capture_output=True)


def read_package(path):
    with zipfile.ZipFile(path) as z:
        names = z.namelist()
        allowed = {"manifest.json", "manifest.sig", "payload.squashfs"}
        if set(names) != allowed or len(names) != len(allowed):
            raise ValueError("SMX must contain exactly manifest.json, manifest.sig and payload.squashfs")
        for info in z.infolist():
            if info.file_size > MAX_PAYLOAD or info.filename.startswith("/") or ".." in pathlib.PurePosixPath(info.filename).parts:
                raise ValueError("unsafe or oversized SMX member")
        manifest = z.read("manifest.json")
        signature = z.read("manifest.sig")
        payload = z.read("payload.squashfs")
    if len(manifest) > MAX_MANIFEST:
        raise ValueError("manifest too large")
    data = json.loads(manifest)
    required = {"id", "name", "version", "arch", "sha256"}
    if not required.issubset(data):
        raise ValueError("manifest missing required fields")
    ext_id = data["id"]
    if not isinstance(ext_id, str) or not ext_id.replace("-", "").replace("_", "").isalnum():
        raise ValueError("invalid extension id")
    machine = os.uname().machine
    arch = "amd64" if machine == "x86_64" else "arm64" if machine == "aarch64" else machine
    if data["arch"] not in ("all", arch, machine):
        raise ValueError("extension is for a different architecture")
    if hashlib.sha256(payload).hexdigest() != str(data["sha256"]).lower():
        raise ValueError("payload SHA-256 mismatch")
    if not PUBKEY.is_file():
        raise ValueError("no trusted extension public key installed")
    with tempfile.TemporaryDirectory(prefix="smth-verify-") as td:
        m = pathlib.Path(td) / "manifest.json"
        s = pathlib.Path(td) / "manifest.sig"
        m.write_bytes(manifest)
        s.write_bytes(signature)
        result = subprocess.run(["openssl", "dgst", "-sha256", "-verify", str(PUBKEY), "-signature", str(s), str(m)], capture_output=True)
        if result.returncode:
            raise ValueError("invalid extension signature")
    return data, payload


def paths(ext_id):
    if not ext_id or not ext_id.replace("-", "").replace("_", "").isalnum():
        raise ValueError("invalid extension id")
    return STATE / ext_id, MOUNT / ext_id


def mount_extension(ext_id):
    state, target = paths(ext_id)
    payload = state / "payload.squashfs"
    if not payload.is_file():
        raise ValueError("extension payload is missing")
    target.mkdir(parents=True, exist_ok=True)
    if run(["mountpoint", "-q", str(target)], check=False).returncode == 0:
        return
    run(["mount", "-t", "squashfs", "-o", "loop,ro,nodev,nosuid", str(payload), str(target)])
    apps = target / "usr/share/applications"
    if apps.is_dir():
        APP_LINKS.mkdir(parents=True, exist_ok=True)
        for desktop in apps.glob("*.desktop"):
            link = APP_LINKS / f"smth-ext-{ext_id}-{desktop.name}"
            if not link.exists():
                link.symlink_to(desktop)


def unmount_extension(ext_id):
    state, target = paths(ext_id)
    for link in APP_LINKS.glob(f"smth-ext-{ext_id}-*.desktop"):
        if link.is_symlink() or link.exists():
            link.unlink()
    if target.exists() and run(["mountpoint", "-q", str(target)], check=False).returncode == 0:
        run(["umount", str(target)])
    try:
        target.rmdir()
    except OSError:
        pass


def install(path):
    if os.geteuid() != 0:
        raise PermissionError("install requires root; use sudo smthctl extension install FILE.smx")
    manifest, payload = read_package(path)
    ext_id = manifest["id"]
    state, _ = paths(ext_id)
    STATE.mkdir(parents=True, exist_ok=True)
    stage = pathlib.Path(tempfile.mkdtemp(prefix=f".{ext_id}-", dir=STATE))
    backup = STATE / f".{ext_id}.previous"
    try:
        (stage / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n")
        (stage / "payload.squashfs").write_bytes(payload)
        if backup.exists():
            shutil.rmtree(backup)
        if state.exists():
            unmount_extension(ext_id)
            state.rename(backup)
        stage.rename(state)
        try:
            mount_extension(ext_id)
        except Exception:
            shutil.rmtree(state, ignore_errors=True)
            if backup.exists():
                backup.rename(state)
                try:
                    mount_extension(ext_id)
                except Exception:
                    pass
            raise
        shutil.rmtree(backup, ignore_errors=True)
    finally:
        shutil.rmtree(stage, ignore_errors=True)
    print(f"Installed and mounted {manifest['name']} {manifest['version']} ({ext_id})")


def remove(ext_id):
    if os.geteuid() != 0:
        raise PermissionError("remove requires root; use sudo smthctl extension remove ID")
    state, _ = paths(ext_id)
    if not state.is_dir():
        raise ValueError(f"extension not installed: {ext_id}")
    unmount_extension(ext_id)
    shutil.rmtree(state)
    print(f"Removed {ext_id}")


def activate_all():
    if os.geteuid() != 0:
        raise PermissionError("activation requires root")
    if STATE.exists():
        for d in sorted(STATE.iterdir()):
            if d.is_dir() and (d / "payload.squashfs").is_file():
                mount_extension(d.name)


def main():
    cli = argparse.ArgumentParser(prog="smthctl", description="SMTH OS system and extension control")
    sub = cli.add_subparsers(dest="group", required=True)
    ext = sub.add_parser("extension", help="manage signed .smx extensions")
    es = ext.add_subparsers(dest="action", required=True)
    p = es.add_parser("verify")
    p.add_argument("file")
    p = es.add_parser("install")
    p.add_argument("file")
    p = es.add_parser("remove")
    p.add_argument("id")
    es.add_parser("list")
    es.add_parser("activate-all")
    args = cli.parse_args()
    try:
        if args.action == "verify":
            m, _ = read_package(args.file)
            print(f"OK: {m['name']} {m['version']} ({m['id']})")
        elif args.action == "install":
            install(args.file)
        elif args.action == "remove":
            remove(args.id)
        elif args.action == "activate-all":
            activate_all()
        elif args.action == "list":
            if STATE.exists():
                for d in sorted(STATE.iterdir()):
                    f = d / "manifest.json"
                    if f.is_file():
                        m = json.loads(f.read_text())
                        print(f"{m.get('id')}\t{m.get('name')}\t{m.get('version')}")
    except Exception as e:
        print(f"smthctl: {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
