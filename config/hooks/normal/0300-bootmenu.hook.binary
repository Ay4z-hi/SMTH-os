#!/bin/sh
# Rebuilds the boot menus (UEFI/ARM GRUB and BIOS isolinux) with SMTH branding. Runs on the host in the build directory.
set -e
K=$(ls binary/live/vmlinuz* 2>/dev/null | head -n1 | sed 's|^binary||')
I=$(ls binary/live/initrd.img* 2>/dev/null | head -n1 | sed 's|^binary||')
if [ -z "$K" ] || [ -z "$I" ]; then echo "SMTH: kernel not found, keeping default boot menu"; exit 0; fi
SRC=config/includes.chroot_after_packages/usr/share/smth/boot
OPTS="boot=live components quiet splash loglevel=3 username=smth hostname=smth"

# ---- GRUB ----
if [ -d binary/boot/grub ]; then
  mkdir -p binary/boot/grub/themes/smth
  cp $SRC/theme.txt $SRC/background.png binary/boot/grub/themes/smth/
  cp /usr/share/grub/unicode.pf2 binary/boot/grub/ 2>/dev/null || true
  cat > binary/boot/grub/grub.cfg <<EOT
set default=0
set timeout=4
insmod all_video
insmod gfxterm
insmod png
loadfont /boot/grub/unicode.pf2
set gfxmode=auto
terminal_output gfxterm
set theme=/boot/grub/themes/smth/theme.txt
menuentry "Start SMTH OS" {
  linux $K $OPTS
  initrd $I
}
menuentry "SMTH OS (safe graphics)" {
  linux $K $OPTS nomodeset
  initrd $I
}
menuentry "SMTH OS (verbose)" {
  linux $K boot=live components username=smth hostname=smth
  initrd $I
}
EOT
fi

# ---- isolinux (BIOS) ----
if [ -d binary/isolinux ]; then
  cp $SRC/splash.png binary/isolinux/splash.png
  cat > binary/isolinux/isolinux.cfg <<EOT
UI vesamenu.c32
DEFAULT smth
TIMEOUT 40
PROMPT 0
MENU TITLE
MENU BACKGROUND splash.png
MENU COLOR screen 0 #ffffff #00000000 none
MENU COLOR border 0 #00000000 #00000000 none
MENU COLOR title 0 #19e6d0 #00000000 none
MENU COLOR unsel 0 #9aa0c8 #00000000 none
MENU COLOR sel 0 #000000 #19e6d0 none
MENU COLOR hotsel 0 #000000 #19e6d0 none
MENU COLOR tabmsg 0 #7c5cff #00000000 none
MENU COLOR timeout 0 #7c5cff #00000000 none
MENU COLOR timeout_msg 0 #7c5cff #00000000 none
MENU COLOR cmdline 0 #ffffff #00000000 none
MENU WIDTH 40
MENU MARGIN 0
MENU ROWS 4
MENU VSHIFT 15
MENU HSHIFT 20
MENU TABMSGROW 21
MENU CMDLINEROW 21
MENU TABMSG
LABEL smth
  MENU LABEL Start SMTH OS
  KERNEL $K
  APPEND initrd=$I $OPTS
LABEL safe
  MENU LABEL SMTH OS (safe graphics)
  KERNEL $K
  APPEND initrd=$I $OPTS nomodeset
LABEL verbose
  MENU LABEL SMTH OS (verbose)
  KERNEL $K
  APPEND initrd=$I boot=live components username=smth hostname=smth
EOT
fi
