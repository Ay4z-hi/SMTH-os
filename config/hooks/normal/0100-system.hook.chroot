#!/bin/sh
set -e
chmod +x /usr/local/bin/* /usr/local/lib/smth/* /etc/skel/.local/share/nautilus/scripts/* 2>/dev/null || true
sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="SMTH OS"/' /etc/os-release
echo 'vm.swappiness=150' > /etc/sysctl.d/99-smth.conf

# services
# freezerd is intentionally not enabled: it is still a scaffold (see
# docs/architecture/rust-migration.md) and starting a daemon that cannot act on
# foreground state would be a fake feature.
mkdir -p /var/lib/smth/extensions /opt/smth/extensions
touch /var/lib/smth/extensions/.keep
systemctl enable zramswap.service NetworkManager.service bluetooth.service nftables.service smth-extensions.service smth-bootcheck.service 2>/dev/null || true
mkdir -p /etc/systemd/system/multi-user.target.wants
ln -sf /etc/systemd/system/smth-extensions.service /etc/systemd/system/multi-user.target.wants/smth-extensions.service
ln -sf /etc/systemd/system/smth-bootcheck.service /etc/systemd/system/multi-user.target.wants/smth-bootcheck.service
systemctl set-default multi-user.target   # labwc is started from the tty1 autologin shell

# Pre-create the live user so agetty autologin on tty1 works before live-config runs.
# live-config's user-setup skips when the user already exists, so this does not
# conflict with username=smth on the kernel command line.
if ! id smth >/dev/null 2>&1; then
    useradd -m -s /bin/bash -G audio,cdrom,dip,floppy,video,plugdev,netdev,bluetooth,sudo smth
    echo 'smth:live' | chpasswd
fi

# The graphical session is started by the tty1 login shell, so that login must
# exist on every architecture.  Relying on live-config to create the autologin
# override is fragile: its user-setup step is skipped when the user already
# exists (we create smth above), and without the override the image stops at a
# login prompt with no compositor and no way for smth-bootcheck to pass.  Install
# the drop-in explicitly and idempotently; it only affects tty1 on this live
# image and keeps logind/PAM session registration intact.
mkdir -p /etc/systemd/system/getty@tty1.service.d
cat > /etc/systemd/system/getty@tty1.service.d/autologin.conf <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty --autologin smth --noclear %I $TERM
EOF
systemctl enable getty@tty1.service 2>/dev/null || true

# desktop defaults (dark, SMTH icons, Inter)
dconf update

# MIME + desktop DB so images/.exe/.apk open in the SMTH Hypervisor
update-mime-database /usr/share/mime
update-desktop-database /usr/share/applications

# generate the SMTH icon theme and index the bundled fonts (offline)
python3 /usr/local/share/smth/icons/gen_icons.py /usr/share/icons/SMTH
gtk-update-icon-cache -f /usr/share/icons/SMTH 2>/dev/null || true
fc-cache -f >/dev/null 2>&1 || true

# hide upstream launchers; SMTH-branded entries replace them
# `[ -f "$d" ] && sed ...` as the last command of a loop body aborts the whole
# hook under `set -e` when a launcher is not installed. Use an explicit if.
for f in org.gnome.Nautilus org.gnome.Snapshot org.gnome.Loupe com.github.maoschanz.drawing Alacritty org.gnome.FileRoller; do
  d=/usr/share/applications/$f.desktop
  if [ -f "$d" ]; then
    sed -i '0,/^\[Desktop Entry\]/s//[Desktop Entry]\nNoDisplay=true/' "$d"
  else
    echo "smth: $f is not installed, nothing to hide"
  fi
done
echo "smth: system hook complete"
