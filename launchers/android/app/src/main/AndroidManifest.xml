<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 11+ hides other packages unless we declare the intent we query.
         Without this, queryIntentActivities() returns only a couple of system
         apps and the launcher would silently show almost no applications. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:theme="@style/SMTH"
        android:label="SMTH Launcher"
        android:icon="@drawable/ic_launcher_smth"
        android:allowBackup="false"
        android:supportsRtl="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- Also launchable from another launcher's app list, which is how
                     a user gets back to SMTH Home after switching away. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
